---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "DMC – Creative Digital Arts Club at DMC College Foundation, Inc. A community for photographers, videographers, editors, animators, and designers.",
} = Astro.props;

const FORM_URL = "https://forms.gle/cCZSLsou414bvr5Z8";
const FB_URL = "https://www.facebook.com/dmccreativedigitalartsclub";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav">
      <div class="wrap">
        <div class="logo">
          <span class="badge">DMC</span> CREATIVE DIGITAL ARTS CLUB
        </div>
        <a class="nav-cta" href={FORM_URL} target="_blank" rel="noopener">Apply Now</a>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap">
        <span class="mono">DMC — Creative Digital Arts Club · Dipolog City</span>
        <a class="fb mono" href={FB_URL} target="_blank" rel="noopener">Facebook →</a>
      </div>
    </footer>
  </body>
</html>
